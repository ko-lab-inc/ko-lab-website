# =============================================================================
# KO-LAB Inc. — Modèle de variables d'environnement
# =============================================================================
#
# Ce fichier EST commité. Il ne doit contenir aucune valeur — uniquement les
# clés attendues et leur documentation.
#
# Au clone du dépôt :
#     cp .env.example .env.local
# puis remplir .env.local (ignoré par Git) avec les valeurs de développement.
#
# En production et en preview, ces variables se configurent dans le dashboard
# Vercel (skill 07) — jamais dans le code, jamais dans un fichier commité.
#
# Toute nouvelle variable ajoutée à .env.local doit être répercutée ici,
# sans sa valeur.
# =============================================================================


# -----------------------------------------------------------------------------
# Supabase — exposé au navigateur
# -----------------------------------------------------------------------------
# Le préfixe NEXT_PUBLIC_ inclut la valeur dans le bundle client : n'y mettre
# que ce qui peut être public. L'URL et la clé anon sont conçues pour ça,
# c'est le RLS (skill 03) qui protège réellement les données.
#
# Dashboard Supabase > Project Settings > API
#
# NEXT_PUBLIC_SUPABASE_URL sert aussi à next.config.mjs pour construire la CSP
# et remotePatterns. Si elle est absente, on retombe sur *.supabase.co.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# -----------------------------------------------------------------------------
# Supabase — backend uniquement
# -----------------------------------------------------------------------------
# ⚠️  La service role key CONTOURNE toutes les politiques RLS.
#     - jamais de préfixe NEXT_PUBLIC_
#     - jamais importée dans un composant client
#     - jamais loggée (skill 14)
#     Usage strict : src/lib/supabase/admin.ts, appelé depuis les API routes.

SUPABASE_SERVICE_ROLE_KEY=


# -----------------------------------------------------------------------------
# Resend — envoi des courriels
# -----------------------------------------------------------------------------
# Notifications des formulaires de contact et demandes boutique (skill 05).
# Backend uniquement. https://resend.com/api-keys

RESEND_API_KEY=


# -----------------------------------------------------------------------------
# Feature flags
# -----------------------------------------------------------------------------
# Page « Solutions modulaires » / catégorie Conteneurs de la boutique.
# Entente commerciale confirmée par Christian le 28 juillet 2026 — mettre à
# 'true' en Production ET Preview sur Vercel pour l'activer (voir .env.local
# pour le détail). Laisser vide ou absent = désactivé.

# ⚠️ DEPUIS LA MIGRATION 0011, CE DRAPEAU N'EST QU'UN REPLI.
# La valeur en vigueur vit dans la table `reglages` et se modifie depuis
# l'espace équipe (Réglages › Parties du site), sans redéploiement. Cette
# variable ne sert plus que si la table est injoignable ou pas encore créée.

NEXT_PUBLIC_SOLUTIONS_MODULAIRES=


# -----------------------------------------------------------------------------
# URL du site — optionnel
# -----------------------------------------------------------------------------
# Utilisé pour les canonical, hreflang et le sitemap (skill 10).
# Vide en local = repli sur https://ko-lab.ca.
#
# À définir sur Vercel par environnement, pour éviter qu'une preview
# n'annonce des canonical pointant vers la production :
#   production → https://ko-lab.ca
#   preview    → https://develop.ko-lab.ca

NEXT_PUBLIC_SITE_URL=


# -----------------------------------------------------------------------------
# Crisp — bulle de chat
# -----------------------------------------------------------------------------
# Identifiant de site Crisp (Settings > Website Settings > Setup instructions).
# Vide = le widget ne se charge pas du tout. Aucune erreur, aucune requête.
#
# ⚠️ Le compte doit appartenir à KO-LAB Inc., pas à un compte personnel.
# ⚠️ Couleur du lanceur à régler dans le tableau de bord Crisp (Appearance) :
#    noir KO-LAB #111210. Le widget vit dans une iframe, notre CSS ne
#    l'atteint pas. Éviter le bleu #61b4db, réservé aux actions du site.
#
# À ajouter dans Vercel en Production ET Preview.

NEXT_PUBLIC_CRISP_WEBSITE_ID=


# -----------------------------------------------------------------------------
# Panier de demande de prix — désactivé
# -----------------------------------------------------------------------------
# Décision de Christian : le panier reste dans le code (Context, localStorage,
# tests E2E) mais invisible tant que le système de gestion admin/vendeur et la
# tarification réelle par produit n'existent pas — chantier séparé, pas encore
# démarré. Voir src/lib/config/features.ts.
#
# Absente ou différente de 'true' = désactivé (comportement de production).
# NE PAS activer sur Vercel tant que le chantier n'a pas démarré.

# ⚠️ DEPUIS LA MIGRATION 0011, CE DRAPEAU N'EST QU'UN REPLI.
# La valeur en vigueur vit dans la table `reglages` et se modifie depuis
# l'espace équipe (Réglages › Parties du site), sans redéploiement. Cette
# variable ne sert plus que si la table est injoignable ou pas encore créée.

NEXT_PUBLIC_FEATURE_PANIER=
